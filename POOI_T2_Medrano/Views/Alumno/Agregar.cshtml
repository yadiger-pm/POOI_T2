@model POOI_T2_Medrano.Models.Alumno

@{
    ViewBag.Title = "Agregar Alumno";
}

<h2>Agregar Alumno</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

@using (Html.BeginForm())
{
    <div class="form-horizontal">
        <hr />
        <div class="form-group">
            <label class="control-label col-md-2">DNI</label>
            <div class="col-md-10">
                @Html.EditorFor(model => model.dni, new { htmlAttributes = new { @class = "form-control", required = "required" } })
            </div>
        </div>

        <div class="form-group">
            <label class="control-label col-md-2">Nombres</label>
            <div class="col-md-10">
                @Html.EditorFor(model => model.nombres, new { htmlAttributes = new { @class = "form-control", required = "required" } })
            </div>
        </div>

        <div class="form-group">
            <label class="control-label col-md-2">Apellidos</label>
            <div class="col-md-10">
                @Html.EditorFor(model => model.apellidos, new { htmlAttributes = new { @class = "form-control", required = "required" } })
            </div>
        </div>

        <div class="form-group">
            <label class="control-label col-md-2">Carrera</label>
            <div class="col-md-10">
                @Html.EditorFor(model => model.carrera, new { htmlAttributes = new { @class = "form-control", required = "required" } })
            </div>
        </div>

        <div class="form-group">
            <label class="control-label col-md-2">Ciclo</label>
            <div class="col-md-10">
                @Html.EditorFor(model => model.ciclo, new { htmlAttributes = new { @class = "form-control", required = "required" } })
            </div>
        </div>

        <br />
        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Guardar Alumno" class="btn btn-success" />
                @Html.ActionLink("Regresar al Listado", "Index", null, new { @class = "btn btn-default" })
            </div>
        </div>
    </div>
}
